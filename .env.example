# OpenAI API Key (Never commit real API keys to version control)
OPENAI_API_KEY=your_key_here

# Speech-to-Text Model Configuration
# Primary courtroom live speech transcription model
OPENAI_TRANSCRIPTION_MODEL=gpt-live-transcribe

# Final high-accuracy transcription model (configurable)
OPENAI_FINAL_TRANSCRIPTION_MODEL=gpt-transcribe
